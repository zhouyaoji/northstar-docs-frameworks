{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouyaoji.github.io/northstar-docs-frameworks/evaluation/schemas/import-report.schema.json",
  "title": "Northstar evaluation response import report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "suiteVersion",
    "protocolVersion",
    "importedAt",
    "counts",
    "generators",
    "responses",
    "invalidResponses"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "suiteVersion": {"type": "string", "minLength": 1},
    "protocolVersion": {"type": "string", "minLength": 1},
    "importedAt": {"type": "string", "format": "date-time"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedPackets", "responseFiles", "imported", "invalid", "missing"],
      "properties": {
        "expectedPackets": {"type": "integer", "minimum": 0},
        "responseFiles": {"type": "integer", "minimum": 0},
        "imported": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "model", "interface", "received", "expected", "missing"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "minLength": 1},
          "received": {"type": "integer", "minimum": 0},
          "expected": {"type": "integer", "minimum": 0},
          "missing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseId", "blindedCondition"],
              "properties": {
                "caseId": {"type": "string", "minLength": 1},
                "blindedCondition": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responseId", "generatorId", "caseId", "blindedCondition", "sha256", "deterministicDecision"],
        "properties": {
          "responseId": {"type": "string", "minLength": 1},
          "generatorId": {"type": "string", "minLength": 1},
          "caseId": {"type": "string", "minLength": 1},
          "blindedCondition": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "deterministicDecision": {"enum": ["pass", "needs-review", "fail"]}
        }
      }
    },
    "invalidResponses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "errors"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
